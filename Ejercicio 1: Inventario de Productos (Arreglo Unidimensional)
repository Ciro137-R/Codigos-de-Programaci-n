#include <stdio.h>

int main() {
    // 1. Declara un arreglo de tipo float llamado precios para almacenar 5 productos
    float precios[5];
    float total = 0.0;
    float promedio = 0.0;

    // 2. Pide al usuario que ingrese los 5 precios, uno por uno, y guárdalos en el arreglo
    for (int i = 0; i < 5; i++) {
        printf("Ingrese el precio del producto %d: ", i + 1);
        scanf("%f", &precios[i]);
    }

    // 3. Usa un bucle for para sumar todos los precios
    for (int i = 0; i < 5; i++) {
        total += precios[i];
    }

    // 4. Calcula el precio total y el precio promedio de todos los productos
    promedio = total / 5.0;

    // 5. Imprime en pantalla la lista de precios, el precio total y el promedio con dos decimales
    printf("\n--- Lista de Precios ---\n");
    for (int i = 0; i < 5; i++) {
        printf("Producto %d: %.2f\n", i + 1, precios[i]);
    }

    printf("\nEl precio total es: %.2f\n", total);
    printf("El precio promedio es: %.2f\n", promedio);

    return 0;
}
