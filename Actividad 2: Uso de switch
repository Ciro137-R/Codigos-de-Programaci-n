#include <stdio.h>

int main() {
    int dia;
    
    // Solicitar al usuario un número del 1 al 7
    printf("Ingrese un número del 1 al 7: ");
    scanf("%d", &dia);
    
    // Evaluar el número ingresado
    switch(dia) {
        case 1: 
            printf("Lunes\n"); 
            break;
        case 2: 
            printf("Martes\n"); 
            break;
        case 3: 
            printf("Miércoles\n"); 
            break;
        case 4: 
            printf("Jueves\n"); 
            break;
        case 5: 
            printf("Viernes\n"); 
            break;
        case 6: 
            printf("Sábado\n"); 
            break;
        case 7: 
            printf("Domingo\n"); 
            break;
        default: 
            // Si el número está fuera del rango 1-7
            printf("Número no válido\n"); 
            break;
    }
    
    return 0;
}
