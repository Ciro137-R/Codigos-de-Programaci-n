#include <stdio.h>

int main() {
    // Variable para guardar el resultado de la suma, inicializada en cero
    int suma = 0; 
    
    // Bucle for para iterar del 1 al 100
    for (int i = 1; i <= 100; i++) {
        suma += i; // Acumular el valor actual de i en la variable suma
    }
    
    printf("La suma de los números del 1 al 100 es: %d\n", suma);
    
    return 0;
}
