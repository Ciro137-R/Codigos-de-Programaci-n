#include <stdio.h>

int main() {
    // 1 y 2. Declarar e inicializar la matriz de 4 filas y 5 columnas con 'O'
    char asientos[4][5] = {
        {'O', 'O', 'O', 'O', 'O'},
        {'O', 'O', 'O', 'O', 'O'},
        {'O', 'O', 'O', 'O', 'O'},
        {'O', 'O', 'O', 'O', 'O'}
    };

    int fila, columna;

    // 3 y 4. Pedir las coordenadas de 3 asientos y marcarlos con 'X'
    for (int i = 0; i < 3; i++) {
        printf("Ingrese la fila del asiento reservado (0-3): ");
        scanf("%d", &fila);

        printf("Ingrese la columna del asiento reservado (0-4): ");
        scanf("%d", &columna);

        // Cambiar el carácter en la matriz de 'O' a 'X'
        asientos[fila][columna] = 'X';
        printf("\n");
    }

    // 5. Imprimir la matriz completa para mostrar el mapa actualizado
    printf("Mapa de asientos actualizado:\n");
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 5; j++) {
            printf("%c ", asientos[i][j]);
        }
        printf("\n");
    }

    return 0;
}
